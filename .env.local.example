# Ritual Calls — Environment Variables
# Copy this file: cp .env.local.example .env.local
# Then fill in your real values. Never commit .env.local

# WalletConnect project ID — required
# Get one free at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed RitualPredict contract address on Ritual Chain (1979)
# Leave empty to run in DEMO mode without any wallet
NEXT_PUBLIC_PREDICT_ADDRESS=

# Demo oracle URL override (optional)
NEXT_PUBLIC_DEMO_ORACLE_URL=
